{
  "schemaVersion": 1,
  "id": "catbox",
  "displayName": "Catbox",
  "description": "Upload images to Catbox",
  "icon": "image-x-generic",
  "request": {
    "url": "https://catbox.moe/user/api.php",
    "method": "POST",
    "body": {
      "type": "multipart",
      "fields": {
        "reqtype": "fileupload"
      },
      "fileField": "fileToUpload"
    }
  },
  "preUpload": [
    {
      "mime": [
        "image/jpeg",
        "image/tiff"
      ],
      "fileHandling": "inplace_copy",
      "commands": [
        {
          "argv": [
            "exiv2",
            "rm",
            "${FILE}"
          ]
        }
      ]
    }
  ],
  "response": {
    "url": {
      "type": "text_url"
    }
  },
  "accept": {
    "mimeTypes": [
      "image/*"
    ]
  }
}
