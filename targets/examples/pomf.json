{
  "schemaVersion": 1,
  "id": "pomf",
  "displayName": "Pomf",
  "description": "Upload files to a Pomf-style host",
  "icon": "folder-upload",
  "request": {
    "url": "https://example.invalid/upload.php",
    "method": "POST",
    "body": {
      "type": "multipart",
      "fields": {},
