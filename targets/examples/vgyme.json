{
  "schemaVersion": 1,
  "id": "vgyme",
  "displayName": "vgy.me",
  "description": "Upload images to vgy.me",
  "icon": "image-x-generic",
  "request": {
    "url": "https://vgy.me/upload",
    "method": "POST",
    "body": {
      "type": "multipart",
      "fields": {},
      "fileField": "file"
    }
  },
  "response": {
    "url": {
      "type": "json_pointer",
      "pointer": "/image"
    },
    "deletion": {
      "type": "json_pointer",
      "pointer": "/delete"
    },
    "error": {
      "type": "json_pointer",
      "pointer": "/description"
    }
  },
  "accept": {
    "mimeTypes": [
      "image/*"
    ],
    "extensions": [
      "jpg",
      "jpeg",
      "png",
      "gif",
      "webp"
    ]
  }
}
