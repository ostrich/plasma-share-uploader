{
  "schemaVersion": 1,
  "id": "uguu",
  "displayName": "Uguu.se",
  "description": "Upload images to uguu.se",
  "icon": "image-x-generic",
  "request": {
    "url": "https://uguu.se/upload",
    "method": "POST",
    "body": {
      "type": "multipart",
      "fields": {},
      "fileField": "files[]"
    }
  },
  "preUpload": [
    {
      "mime": [
        "image/jpeg",
        "image/tiff"
      ],
      "fileHandling": "inplace_copy",
      "commands": [
        {
          "argv": [
            "exiv2",
            "rm",
            "${FILE}"
          ]
        }
      ]
    }
  ],
  "response": {
    "url": {
      "type": "json_pointer",
      "pointer": "/files/0/url"
    },
    "error": {
      "type": "json_pointer",
      "pointer": "/description"
    }
  },
  "accept": {
    "mimeTypes": [
      "image/*"
    ]
  }
}
